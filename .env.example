PORT=3000
NODE_ENV=development

# Base de datos: usar UNA sola DATABASE_URL activa.
# Si la variable se repite, dotenv se queda con la primera y descarta el resto.

# Local (Docker, ver compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curso_express"

# Railway (obtener la cadena desde el panel del servicio PostgreSQL)
#DATABASE_URL="postgresql://postgres:CONTRASEÑA@HOST:PUERTO/railway?sslmode=require"

JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=1h
